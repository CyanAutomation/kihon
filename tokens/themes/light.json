{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "background": {
      "$type": "color",
      "$value": "{colors.warm-gray.100}"
    },
    "surface": {
      "$type": "color",
      "$value": "{colors.white}"
    },
    "text-primary": {
      "$type": "color",
      "$value": "{colors.warm-gray.900}"
    },
    "text-secondary": {
      "$type": "color",
      "$value": "{colors.warm-gray.700}"
    },
    "accent": {
      "$type": "color",
      "$value": "{colors.coral.500}"
    },
    "accent-text": {
      "$type": "color",
      "$value": "{colors.coral.700}"
    },
    "on-accent": {
      "$type": "color",
      "$value": "{colors.warm-gray.900}"
    },
    "button-primary-hover": {
      "$type": "color",
      "$value": "{colors.coral.600}"
    },
    "danger": {
      "$type": "color",
      "$value": "{colors.red.700}"
    },
    "success": {
      "$type": "color",
      "$value": "{colors.green.800}"
    },
    "success-background": {
      "$type": "color",
      "$value": "{colors.green.50}"
    },
    "border-subtle": {
      "$type": "color",
      "$value": "{colors.warm-gray.300}"
    },
    "border-strong": {
      "$type": "color",
      "$value": "{colors.warm-gray.600}"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{colors.coral.700}"
    },
    "scrim": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.38,
        "hex": "#000000"
      }
    }
  },
  "$description": "Light appearance theme for Kihon UI Foundation"
}
