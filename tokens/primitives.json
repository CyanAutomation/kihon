{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "name": "Kihon Primitives",
  "description": "Primitive colour, spacing, and scale values for Kihon UI Foundation",
  "colors": {
    "gray": {
      "50": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "100": {
        "$type": "color",
        "$value": "#f5f5f7"
      },
      "200": {
        "$type": "color",
        "$value": "#e5e5ea"
      },
      "300": {
        "$type": "color",
        "$value": "#d0d5dd"
      },
      "400": {
        "$type": "color",
        "$value": "#a6acb1"
      },
      "500": {
        "$type": "color",
        "$value": "#8690a0"
      },
      "600": {
        "$type": "color",
        "$value": "#667085"
      },
      "700": {
        "$type": "color",
        "$value": "#475467"
      },
      "800": {
        "$type": "color",
        "$value": "#1f2024"
      },
      "900": {
        "$type": "color",
        "$value": "#141518"
      }
    },
    "blue": {
      "50": {
        "$type": "color",
        "$value": "#eff6ff"
      },
      "100": {
        "$type": "color",
        "$value": "#deebff"
      },
      "200": {
        "$type": "color",
        "$value": "#c7deff"
      },
      "300": {
        "$type": "color",
        "$value": "#a4cafe"
      },
      "400": {
        "$type": "color",
        "$value": "#85b4ff"
      },
      "500": {
        "$type": "color",
        "$value": "#4d96ff"
      },
      "600": {
        "$type": "color",
        "$value": "#2563eb"
      },
      "700": {
        "$type": "color",
        "$value": "#175cd3"
      },
      "800": {
        "$type": "color",
        "$value": "#1e40af"
      },
      "900": {
        "$type": "color",
        "$value": "#1e3a8a"
      }
    },
    "red": {
      "50": {
        "$type": "color",
        "$value": "#fef2f2"
      },
      "100": {
        "$type": "color",
        "$value": "#fee2e2"
      },
      "200": {
        "$type": "color",
        "$value": "#fecaca"
      },
      "300": {
        "$type": "color",
        "$value": "#fca5a5"
      },
      "400": {
        "$type": "color",
        "$value": "#f87171"
      },
      "500": {
        "$type": "color",
        "$value": "#f97066"
      },
      "600": {
        "$type": "color",
        "$value": "#dc2626"
      },
      "700": {
        "$type": "color",
        "$value": "#b42318"
      },
      "800": {
        "$type": "color",
        "$value": "#7f1d1d"
      },
      "900": {
        "$type": "color",
        "$value": "#5f1212"
      }
    },
    "white": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "black": {
      "$type": "color",
      "$value": "#000000"
    }
  },
  "spacing": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "typography": {
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "base": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2rem"
      }
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.75
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "font-stack": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "0",
        "blur": "0",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0)"
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0.05)"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "6px",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0.07)"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "12px",
        "blur": "16px",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0.1)"
      }
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "normal": {
      "$type": "duration",
      "$value": "200ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "300ms"
    }
  }
}
