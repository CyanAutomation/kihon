{
  "name": "kihon",
  "version": "1.0.0-draft.1",
  "description": "Kihon UI Foundation — A lightweight, framework-free design system for CyanAutomation",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/CyanAutomation/kihon.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build-tokens && npm run build:runtime",
    "build-tokens": "node scripts/build-tokens.js",
    "build:runtime": "node scripts/build-runtime.js",
    "typecheck": "tsc --project tsconfig.json",
    "validate": "node scripts/validate-tokens.js",
    "sanity": "node scripts/sanity-check.js",
    "check:generated": "node scripts/check-generated.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run validate && npm run sanity && npm run check:generated && npm run test:browser",
    "dev": "npm run build && node scripts/serve.js",
    "check": "npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "html-validate": "~11.1.0",
    "postcss": "^8.5.32",
    "typescript": "^7.0.2",
    "wcag-contrast": "^3.0.0"
  }
}
