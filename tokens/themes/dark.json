{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "background": {
      "$type": "color",
      "$value": "{colors.gray.900}"
    },
    "surface": {
      "$type": "color",
      "$value": "{colors.gray.800}"
    },
    "text-primary": {
      "$type": "color",
      "$value": "{colors.gray.100}"
    },
    "text-secondary": {
      "$type": "color",
      "$value": "{colors.gray.400}"
    },
    "accent": {
      "$type": "color",
      "$value": "{colors.orange.500}"
    },
    "accent-text": {
      "$type": "color",
      "$value": "{colors.orange.500}"
    },
    "on-accent": {
      "$type": "color",
      "$value": "{colors.gray.900}"
    },
    "button-primary-hover": {
      "$type": "color",
      "$value": "{colors.orange.400}"
    },
    "danger": {
      "$type": "color",
      "$value": "{colors.red.500}"
    },
    "success": {
      "$type": "color",
      "$value": "{colors.green.300}"
    },
    "success-background": {
      "$type": "color",
      "$value": "{colors.green.900}"
    },
    "border-subtle": {
      "$type": "color",
      "$value": "{colors.gray.700}"
    },
    "border-strong": {
      "$type": "color",
      "$value": "{colors.gray.600}"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{colors.orange.400}"
    }
  },
  "$description": "Dark appearance theme for Kihon UI Foundation"
}
