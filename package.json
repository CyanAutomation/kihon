{
  "name": "@cyanautomation/kihon",
  "version": "1.0.0-draft.2",
  "description": "Kihon UI Foundation — A lightweight, framework-free design system for CyanAutomation",
  "private": true,
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CyanAutomation/kihon.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    "./dialogs": {
      "import": {
        "types": "./dist/types/dialogs.d.mts",
        "default": "./dist/esm/dialogs.mjs"
      },
      "require": {
        "types": "./dist/types/dialogs.d.cts",
        "default": "./dist/cjs/dialogs.cjs"
      }
    },
    "./sidebar": {
      "import": {
        "types": "./dist/types/sidebar.d.mts",
        "default": "./dist/esm/sidebar.mjs"
      },
      "require": {
        "types": "./dist/types/sidebar.d.cts",
        "default": "./dist/cjs/sidebar.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.compat.css": "./dist/styles.compat.css",
    "./browser/dialogs.js": "./dist/browser/dialogs.global.js",
    "./browser/sidebar.js": "./dist/browser/sidebar.global.js"
  },
  "scripts": {
    "build": "npm run build-tokens && npm run build:runtime && npm run build:package && npm run build:style-guide",
    "build-tokens": "tsx scripts/build-tokens.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "build:package": "tsx scripts/build-package.ts",
    "build:style-guide": "tsx scripts/build-style-guide.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.node.json && tsc --project tsconfig.browser.json && tsc --project tsconfig.playwright.json",
    "validate": "tsx scripts/validate-tokens.ts",
    "sanity": "tsx scripts/sanity-check.ts",
    "check:generated": "tsx scripts/check-generated.ts",
    "test:package": "tsx tests/package/test-package.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:unit:coverage": "tsx scripts/run-unit-coverage.ts",
    "test:browser": "playwright test",
    "test": "npm run test:unit:coverage && npm run validate && npm run sanity && npm run check:generated && npm run test:browser",
    "serve": "tsx scripts/serve.ts",
    "dev": "npm run build && npm run serve",
    "check": "npm test",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code --format json --quiet",
    "fallow:dupes": "fallow dupes --format json --quiet",
    "fallow:health": "fallow health --format json --quiet",
    "fallow:audit": "fallow audit --format json --quiet"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "fallow": "3.47.0",
    "fallow-type-aware": "3.47.0",
    "html-validate": "~11.21.1",
    "postcss": "^8.5.33",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wcag-contrast": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
